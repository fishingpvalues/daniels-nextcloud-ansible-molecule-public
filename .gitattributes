# Enforce LF for all code and config files (best for cross-platform)
*.sh     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf

# Enforce CRLF for Windows batch files
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Prevent line ending conversion for binary files
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.exe    binary
*.dll    binary
*.zip    binary
*.tar    binary
*.gz     binary
*.bz2    binary
*.7z     binary 